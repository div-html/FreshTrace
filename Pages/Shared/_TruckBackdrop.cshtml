<!-- Animated Farm-to-Fork Truck Transit Background -->
<div class="truck-transit-backdrop" aria-hidden="true">
  <div class="transit-sky">
    <div class="sky-night-backdrop"></div>

    <div class="transit-stars">
      <div class="star star-1"></div>
      <div class="star star-2"></div>
      <div class="star star-3"></div>
      <div class="star star-4"></div>
      <div class="star star-5"></div>
      <div class="star star-6"></div>
      <div class="star star-7"></div>
      <div class="star star-8"></div>
      <div class="star star-9"></div>
      <div class="star star-10"></div>
    </div>

    <div class="transit-sun">
      <div class="sun-corona"></div>
    </div>

    <div class="transit-moon">
      <div class="moon-crater crater-1"></div>
      <div class="moon-crater crater-2"></div>
      <div class="moon-crater crater-3"></div>
      <div class="moon-halo"></div>
    </div>

    <div class="transit-cloud cloud-1"></div>
    <div class="transit-cloud cloud-2"></div>
    <div class="transit-cloud cloud-3"></div>
  </div>

  <div class="transit-hills">
    <svg class="hills-svg" viewBox="0 0 1440 180" preserveAspectRatio="none">
      <path fill="#e6f2e1" d="M0,80 C240,140 480,40 720,80 C960,120 1200,50 1440,90 L1440,180 L0,180 Z"></path>
      <path fill="#d8ebce" d="M0,110 C320,60 640,140 960,100 C1200,70 1340,130 1440,120 L1440,180 L0,180 Z"></path>
    </svg>
  </div>

  <!-- Location 1: Farm (Left) -->
  <div class="transit-location location-origin">
    <div class="farm-structures">
      <div class="farm-windmill">
        <div class="windmill-pillar"></div>
        <div class="windmill-hub"></div>
        <div class="windmill-blades">
          <div class="blade blade-1"></div>
          <div class="blade blade-2"></div>
          <div class="blade blade-3"></div>
          <div class="blade blade-4"></div>
        </div>
      </div>
      <div class="farm-barn">
        <div class="barn-roof"></div>
        <div class="barn-body">
          <div class="barn-door"></div>
        </div>
      </div>
      <div class="farm-silo"></div>
      <div class="farm-tree tree-1"></div>
      <div class="farm-tree tree-2"></div>
    </div>
  </div>

  <!-- Location 2: Destination Hub (Right) -->
  <div class="transit-location location-destination">
    <div class="city-structures">
      <div class="city-building building-1">
        <div class="solar-roof"></div>
        <div class="building-windows"></div>
      </div>
      <div class="city-building building-2">
        <div class="warehouse-accent"></div>
        <div class="building-windows"></div>
      </div>
      <div class="city-building building-3">
        <div class="building-windows"></div>
      </div>
    </div>
  </div>

  <!-- Running Delivery Truck -->
  <div class="animated-truck-track">
    <div class="running-truck">
      <div class="gps-signal-wave">
        <div class="signal-ring ring-1"></div>
        <div class="signal-ring ring-2"></div>
      </div>

      <div class="truck-body-wrap">
        <div class="truck-trailer">
          <div class="reefer-unit"></div>
          <div class="trailer-accent-stripe"></div>
        </div>

        <div class="truck-cab">
          <div class="cab-windshield"></div>
          <div class="cab-headlight"></div>
          <div class="headlight-beam"></div>
        </div>
      </div>

      <div class="truck-wheels">
        <div class="wheel wheel-rear">
          <div class="wheel-rim"></div>
        </div>
        <div class="wheel wheel-mid">
          <div class="wheel-rim"></div>
        </div>
        <div class="wheel wheel-front">
          <div class="wheel-rim"></div>
        </div>
      </div>

      <div class="truck-exhaust-puff"></div>
    </div>
  </div>
</div>
