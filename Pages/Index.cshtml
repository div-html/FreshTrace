@page
@model IndexModel
@{
    ViewData["Title"] = "FreshTrace | Agricultural Traceability Platform";
    var isRegister = Model.Mode == "register";
}

<div class="signin-view-wrapper" id="viewAuth">
  <div class="ambient-grid"></div>

  <partial name="_TruckBackdrop" />

  <div class="login-container">
    <div class="login-card">
      <!-- SELECT BETWEEN LOGIN AND REGISTER -->
      <div class="auth-mode-switch" role="tablist">
        <a
          asp-page="/Index"
          asp-route-mode="login"
          id="tabLogin"
          class="auth-mode-tab @(!isRegister ? "active" : "")"
          style="text-decoration: none;"
        >
          <span>Sign In</span>
        </a>

        <a
          asp-page="/Index"
          asp-route-mode="register"
          id="tabRegister"
          class="auth-mode-tab @(isRegister ? "active" : "")"
          style="text-decoration: none;"
        >
          <span>Register</span>
        </a>
      </div>

      @if (!isRegister)
      {
        <!-- ==================== SUB-VIEW: LOGIN ==================== -->
        <div id="view-login-pane">
          <div class="card-header" style="margin-bottom: 1.5rem;">
            <h1 class="card-title">Sign in</h1>
            <p class="card-subtitle">
              Enter your email address and password to access your account.
            </p>
          </div>

          @if (!string.IsNullOrEmpty(Model.LoginError))
          {
            <div class="auth-alert error">
              <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <div>@Model.LoginError</div>
            </div>
          }

          <form method="post" asp-page-handler="Login">
            <div class="form-group">
              <div class="label-row">
                <label class="form-label" for="loginEmailInput">Email address</label>
              </div>
              <div class="input-box">
                <input
                  type="email"
                  id="loginEmailInput"
                  name="LoginEmail"
                  class="form-input"
                  placeholder="name@example.com"
                  value="@Model.LoginEmail"
                  required
                  autocomplete="email"
                />
              </div>
            </div>

            <div class="form-group">
              <div class="label-row">
                <label class="form-label" for="loginPasswordInput">Password</label>
              </div>
              <div class="input-box">
                <input
                  type="password"
                  id="loginPasswordInput"
                  name="LoginPassword"
                  class="form-input form-input-password"
                  placeholder="••••••••••••"
                  required
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  class="btn-toggle-eye"
                  data-toggle-password="loginPasswordInput"
                  aria-label="Toggle password visibility"
                >
                  <svg data-eye-open class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                  <svg data-eye-closed class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="display: none;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <div class="options-row">
              <label class="remember-control">
                <input
                  type="checkbox"
                  name="RememberMe"
                  value="true"
                  class="checkbox-pista"
                  checked="@Model.RememberMe"
                />
                <span>Remember me</span>
              </label>
              <a
                href="#forgot"
                class="link-forgot"
                data-open-modal="forgotPasswordModal"
              >
                Forgot password?
              </a>
            </div>

            <button type="submit" class="btn-signin">
              <span>Sign in</span>
            </button>
          </form>
        </div>
      }
      else
      {
        <!-- ==================== SUB-VIEW: REGISTER ==================== -->
        <div id="view-register-pane">
          <div class="card-header" style="margin-bottom: 1.5rem;">
            <h1 class="card-title">Create an account</h1>
            <p class="card-subtitle">
              Sign up to get started with FreshTrace.
            </p>
          </div>

          @if (!string.IsNullOrEmpty(Model.RegisterError))
          {
            <div class="auth-alert error">
              <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <div>@Model.RegisterError</div>
            </div>
          }

          <form method="post" asp-page-handler="Register">
            <div class="form-group">
              <div class="label-row">
                <label class="form-label" for="regFullNameInput">Full Name</label>
              </div>
              <div class="input-box">
                <input
                  type="text"
                  id="regFullNameInput"
                  name="RegName"
                  class="form-input"
                  placeholder="e.g. Ramesh Patel"
                  value="@Model.RegName"
                  required
                  autocomplete="name"
                />
              </div>
            </div>

            <div class="form-group">
              <div class="label-row">
                <label class="form-label" for="regEmailInput">Email address</label>
              </div>
              <div class="input-box">
                <input
                  type="email"
                  id="regEmailInput"
                  name="RegEmail"
                  class="form-input"
                  placeholder="name@example.com"
                  value="@Model.RegEmail"
                  required
                  autocomplete="email"
                />
              </div>
            </div>

            <div class="form-group">
              <div class="label-row">
                <label class="form-label" for="regPasswordInput">Password</label>
              </div>
              <div class="input-box">
                <input
                  type="password"
                  id="regPasswordInput"
                  name="RegPassword"
                  class="form-input form-input-password"
                  placeholder="Create a password"
                  required
                  autocomplete="new-password"
                />
                <button
                  type="button"
                  class="btn-toggle-eye"
                  data-toggle-password="regPasswordInput"
                  aria-label="Toggle password visibility"
                >
                  <svg data-eye-open class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                  <svg data-eye-closed class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="display: none;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <div class="form-group">
              <div class="label-row">
                <label class="form-label" for="regPhoneInput">Phone</label>
              </div>
              <div class="input-box">
                <input
                  type="tel"
                  id="regPhoneInput"
                  name="RegPhone"
                  class="form-input"
                  placeholder="+91 98160 44219"
                  value="@Model.RegPhone"
                  required
                  autocomplete="tel"
                />
              </div>
            </div>

            <div class="form-group">
              <div class="label-row">
                <label class="form-label" for="regRoleSelect">Supply chain role</label>
              </div>
              <div class="input-box">
                <select id="regRoleSelect" name="RegRole" class="form-input">
                  <option value="farmer" selected="@(Model.RegRole == "farmer")">Farmer</option>
                  <option value="admin" selected="@(Model.RegRole == "admin")">Admin</option>
                  <option value="retailer" selected="@(Model.RegRole == "retailer")">Retailer</option>
                  <option value="distributor" selected="@(Model.RegRole == "distributor")">Distributor</option>
                  <option value="consumer" selected="@(Model.RegRole == "consumer")">Consumer</option>
                </select>
              </div>
            </div>

            <button type="submit" class="btn-signin" style="margin-top: 0.75rem;">
              <span>Create account</span>
            </button>
          </form>
        </div>
      }
    </div>
  </div>
</div>

<!-- ==================== MODAL: FORGOT PASSWORD ==================== -->
<div
  id="forgotPasswordModal"
  class="farmer-modal-backdrop"
  data-modal-backdrop
  style="display: @(Model.ShowForgotModal ? "flex" : "none");"
>
  <div class="farmer-modal" role="dialog" aria-modal="true" aria-labelledby="forgotModalTitle">
    <div class="farmer-modal-header">
      <div>
        <h2 id="forgotModalTitle">Reset Your Password</h2>
        <p>Password reset instructions will be dispatched to your registered email.</p>
      </div>
      <button type="button" class="farmer-modal-close" data-close-modal="forgotPasswordModal" aria-label="Close modal">
        ✕
      </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.ForgotSuccess))
    {
      <div class="farmer-toast" role="status" style="margin-bottom: 1rem;">
        <div class="farmer-toast-left">
          <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--pista-600);">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>@Model.ForgotSuccess</span>
        </div>
      </div>
    }

    <form method="post" asp-page-handler="ForgotPassword" style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label class="form-label" for="forgotEmailInput">Registered Work Email</label>
        <input
          type="email"
          id="forgotEmailInput"
          name="ForgotEmail"
          class="form-input"
          placeholder="your.name@supplychain.org"
          value="@(string.IsNullOrWhiteSpace(Model.ForgotEmail) ? Model.LoginEmail : Model.ForgotEmail)"
          required
          style="margin-top: 0.45rem;"
        />
      </div>

      <div class="farmer-modal-actions">
        <button type="button" class="btn-farmer-secondary" data-close-modal="forgotPasswordModal">Cancel</button>
        <button type="submit" class="btn-farmer-primary">Send Reset Link</button>
      </div>
    </form>
  </div>
</div>
