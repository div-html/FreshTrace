@page
@model ErrorModel
@{
    ViewData["Title"] = "Error - FreshTrace";
}

<div class="signin-view-wrapper">
  <div class="login-container">
    <div class="login-card">
      <div class="card-header">
        <h1 class="card-title">Something went wrong</h1>
        <p class="card-subtitle">An unexpected error occurred while processing your request.</p>
      </div>
      <a href="/" class="btn-signin" style="text-decoration: none;">Return to FreshTrace</a>
    </div>
  </div>
</div>
